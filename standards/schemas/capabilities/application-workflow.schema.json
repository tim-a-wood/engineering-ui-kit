{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/engineering-ui-kit/capabilities/application-workflow.schema.json",
  "title": "Application workflow",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "useCaseId",
    "name",
    "graph",
    "pathIds",
    "acceptanceCaseIds",
    "sourceRefs"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "useCaseId": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "graph": {
      "$ref": "activity-graph.schema.json"
    },
    "pathIds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "acceptanceCaseIds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "sourceRefs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
