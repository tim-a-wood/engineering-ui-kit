  "rules": [
    {
      "id": "rule-authority",
      "text": "Connected engineering artifacts remain authoritative. The hub must not write changes to lifecycle files."
    },
    {
      "id": "rule-local-workflow",
      "text": "Only hub-local findings, reviews, dispositions, package selections, annotations, and sample sandbox state are editable, and every change is auditable."
    },
    {
      "id": "rule-snapshot",
      "text": "Each published snapshot is immutable and identifies exact source revisions, extraction context, and hashes."
    },
    {
      "id": "rule-publish",
      "text": "An extraction or indexing failure prevents candidate publication. An evidence gap stays visible and does not prevent a reliable snapshot."
    },
    {
      "id": "rule-fallback",
      "text": "A failed or partial refresh never replaces the last valid published snapshot."
    },
    {
      "id": "rule-finding",
      "text": "The hub calculates deterministic findings for each snapshot. Human findings keep attribution, history, disposition, and closure evidence."
    },
    {
      "id": "rule-stale",
      "text": "Evidence is stale when its source revision or dependency hash differs from the selected snapshot. Evidence is also stale after an unreviewed dependency change."
    },
    {
      "id": "rule-phases",
      "text": "The Evidence Explorer navigation is Overview, Planning, Requirements, Design, Implementation, Verification, Configuration Management, Quality Assurance, and Certification."
    },
    {
      "id": "rule-shared-anatomy",
      "text": "Every lifecycle area uses a consistent phase header, tailored subnavigation, working evidence table or visualization, evidence inspector, findings drawer, and baseline-compare mode."
    },
    {
      "id": "rule-shared-actions",
      "text": "Each evidence item provides its dossier, traces, source location, baseline comparison, source data, findings, reviews, and package controls."
    },
    {
      "id": "rule-sample-default",
      "text": "If zero real projects exist, the sample opens automatically with no picker blocker or blank dashboard."
    },
    {
      "id": "rule-sample-real",
      "text": "After a real project exists, the last real project opens by default and the sample remains selectable under Examples."
    },
    {
      "id": "rule-sample-badge",
      "text": "The sample always displays a Sample Data badge and a Connect a real project action."
    },
    {
      "id": "rule-sample-overlay",
      "text": "Bundled sample evidence is immutable. A resettable sandbox stores sample findings, reviews, dispositions, packages, and preferences."
    },
    {
      "id": "rule-sample-export",
      "text": "Every sample export is marked Synthetic sample — not certification evidence in both visible output and manifest metadata."
    },
    {
      "id": "rule-sample-portable",
      "text": "The sample uses a normalized extraction snapshot for synthetic artifacts. It must not disguise text or JSON as proprietary binary files."
    },
    {
      "id": "rule-same-ui",
      "text": "Sample projects and real projects use the same APIs, domain model, routes, and components. The product has no demo-only interface."
    },
    {
      "id": "rule-objectives",
      "text": "Do not bundle copyrighted DO-178C or DO-331 objective text. Use configurable identifiers and licensed profiles."
    },
    {
      "id": "rule-claims",
      "text": "The application may report evidence status against the configured profile but must not claim certification, regulatory approval, or compliance."
    },
    {
      "id": "rule-llr",
      "text": "Requirement classifications and allocation rules prevent ambiguous duplication between higher-level and low-level requirement views."
    },
    {
      "id": "rule-coverage",
      "text": "The hub imports coverage from authoritative results. The hub does not calculate coverage."
    },
    {
      "id": "rule-compare",
      "text": "Baseline comparison reports added, removed, changed, and stale evidence without performing semantic merge or conflict resolution."
    },
    {
      "id": "rule-security",
      "text": "Credentials and secrets are never stored in project configuration, snapshots, logs, packages, or displayed evidence."
    },
    {
      "id": "rule-performance",
      "text": "Normal browsing, filtering, search, trace navigation, dossier opening, and phase switching should usually respond within two seconds at accepted scale."
    },
    {
      "id": "rule-determinism",
      "text": "The bundled sample has deterministic identifiers, dates, people, revisions, hashes, relationships, counts, and reset behavior."
    }
  ],
