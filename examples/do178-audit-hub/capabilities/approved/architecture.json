  "moduleDefinitions": [
    {
      "moduleId": "mod.audit-experience",
      "name": "Audit Hub Experience",
      "moduleType": "experience",
      "responsibility": "Own the responsive Audit Hub front end. Provide workspace selection, lifecycle views, search, dossiers, traces, baseline comparison, findings, reviews, packages, sample reset, and refresh status."
    },
    {
      "moduleId": "mod.workspace-snapshots",
      "name": "Workspace snapshots",
      "moduleType": "domain",
      "responsibility": "Own project configuration, objective-profile references, repository definitions, real-versus-sample selection, last-real-project preference, exact revision sets, immutable snapshot identity, baselines, and publication state."
    },
    {
      "moduleId": "mod.lifecycle-explorer",
      "name": "Lifecycle Explorer",
      "moduleType": "domain",
      "responsibility": "Own the lifecycle phase model and shared view structure. Provide phase views, readiness summaries, evidence projections, comparison projections, and approved lifecycle areas."
    },
    {
      "moduleId": "mod.evidence-graph",
      "name": "Evidence Graph",
      "moduleType": "domain",
      "responsibility": "Own normalized lifecycle artifact metadata, typed relationships, requirement-to-result chains, provenance and hashes, dossiers, cross-phase search, staleness evaluation, change impact, and trace traversal."
    },
    {
      "moduleId": "mod.assurance-workflow",
      "name": "Assurance Workflow",
      "moduleType": "domain",
      "responsibility": "Own deterministic and human findings, review and independence records, assignment, disposition, corrective action, reverification, closure history, configurable objective mappings, audit-package membership, manifests, and watermark policy."
    },
    {
      "moduleId": "mod.ingestion-publication",
      "name": "Evidence publication",
      "moduleType": "domain",
      "responsibility": "Own scanning, artifact classification, extractor orchestration, normalization, diagnostics, deterministic check execution, refresh progress, reliability gates, and atomic publication while preserving the last valid snapshot."
    },
    {
      "moduleId": "mod.sample-workspace",
      "name": "Deterministic Sample Workspace",
      "moduleType": "domain",
      "responsibility": "Own the bundled AeroNav snapshot and the 2.3.0 and 2.4.0 baselines. Provide complete chains, incomplete chains, twelve findings, deterministic identities, reset defaults, and offline fallback."
    },
    {
      "moduleId": "mod.evidence-store",
      "name": "Evidence Store",
      "moduleType": "domain",
      "responsibility": "Persist project metadata, immutable snapshots, normalized evidence, graph relationships, reviews, findings, history, overlay state, and package manifests. Provide search, phase, and comparison queries."
    },
    {
      "moduleId": "mod.external-adapters",
      "name": "External Adapters",
      "moduleType": "connection",
      "responsibility": "Provide explicit Git, workspace-filesystem, normalized-extract, optional MATLAB-tooling, source-link, and local-package-export boundaries without leaking credentials or proprietary formats into domain modules."
    }
  ],
