      "reason": "Only the sample module knows bundled defaults and reset semantics."
    },
    {
      "operationId": "op.persist-evidence-state",
      "moduleId": "mod.evidence-store",
      "reason": "Durable canonical and overlay state is owned by the persistence module."
    },
    {
      "operationId": "op.access-external-artifacts",
      "moduleId": "mod.external-adapters",
      "reason": "All technology-specific reads, source links, revision operations, and exports cross explicit adapter ports."
    }
